# Copy to .env for local configuration.  .env is gitignored.
#
# NO SECRETS BELONG IN THIS FILE OR IN .env (PRD NFR-1).
#
# Model access uses your Claude Code subscription login, not an API key.
# There is deliberately no ANTHROPIC_API_KEY here: the pipeline is designed
# around a fixed capacity ceiling, and setting a key would silently move runs
# onto a different credential path. See
# docs/decisions/0002-model-access-via-claude-subscription.md.
# CI authenticates with a CLAUDE_CODE_OAUTH_TOKEN repository secret.

# --- Target -----------------------------------------------------------------

# Which target under targets/ the pipeline operates on.
SOURCEWEAVE_TARGET=anythingllm

# --- Models -----------------------------------------------------------------
# Different tiers for generation and evaluation, per ADR 0002.

SOURCEWEAVE_GENERATION_MODEL=opus
SOURCEWEAVE_EVAL_MODEL=sonnet

# --- Capacity budget ---------------------------------------------------------
# The binding constraint is invocations per window, not spend (ADR 0002).
# These values keep a run inside the ceiling; a run that reaches it anyway
# checkpoints and stops rather than retrying.

# Maximum pages generated in a single run before the pipeline stops.
SOURCEWEAVE_MAX_PAGES_PER_RUN=25

# Seconds to wait between model invocations.
SOURCEWEAVE_THROTTLE_SECONDS=2

# Per-invocation timeout, seconds.
SOURCEWEAVE_TIMEOUT_SECONDS=600

# --- Output -----------------------------------------------------------------

# Run logs and raw evaluation output. Gitignored -- only summarized scores
# are committed (PRD FR-15).
SOURCEWEAVE_RUN_DIR=.runs
